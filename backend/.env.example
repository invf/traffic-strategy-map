OPENAI_API_KEY=sk-proj-your-key-here
# AUTH-003B same-origin proxy (Option B, approved) - the PUBLIC domain
# traffic-map.adveser.com, which Vercel reverse-proxies /api/* and
# /auth/* through to this backend (vercel.json) - NOT the raw
# *.onrender.com or *.vercel.app host. Still required (not an optional
# CORS nicety): the CORS spec forbids credentials with origin "*", and
# the OAuth callback redirects the browser back here. No trailing slash.
FRONTEND_URL=https://traffic-map.adveser.com
PORT=3001

# AUTH-003A - required for the hardened /api/openai endpoint's auth check.
# The shared ADVESER Supabase project's own URL (eukogyljakqafnuvrfiv) -
# used only to verify tokens against its JWKS, never to query data directly.
SUPABASE_URL=https://eukogyljakqafnuvrfiv.supabase.co

# AUTH-003B - the project's PUBLIC anon key (same value already shipped
# in the frontend bundle as VITE_SUPABASE_ANON_KEY - not a secret by
# itself). Required by backend/routes/strategiesProxy.js as PostgREST's
# `apikey` header; per-user identity and row access still come entirely
# from the real access token in the Authorization header, which this
# key does not substitute for.
SUPABASE_ANON_KEY=your-anon-key

# AUTH-003A - a direct Postgres connection as the dedicated
# traffic_strategy_map_app role (see supabase/migrations/
# 20261118120200_provision_app_role.sql) - SELECT-only on
# adveser_core.user_product_entitlements, INSERT/UPDATE on this app's
# own openai_usage/openai_quota tables. Never the anon, service_role,
# or Supabase's own `postgres` administrator role.
#
# AUTH-003B pre-deployment audit fix: REQUIRED for BOTH /api/openai and
# /api/strategies readiness now, not just /api/openai - server.js's own
# startup check includes this explicitly, so neither route activates
# in a misleadingly-"running" state while actually failing closed (503)
# on every real request because this was missing.
#
# AUTH-003C - Supabase's SESSION pooler (port 5432, not the Transaction
# pooler's 6543) - correct for this backend's own long-running process
# with a small, stable connection pool (max: 5 in lib/entitlements.js),
# the same reasoning invf/adveser-platform's own identical-pattern
# connection already documents for its Render-hosted role. The
# username MUST be project-qualified ("<role>.<project-ref>", e.g.
# traffic_strategy_map_app.eukogyljakqafnuvrfiv) - that's how Supabase's
# pooler routes the connection to the right project before Postgres
# ever authenticates it; only the part before the first "." is the
# actual role Postgres authorizes as. sslmode=require is REQUIRED, not
# optional - confirmed directly (see backend/lib/entitlements.js's own
# comment): `pg`'s own connection-string parser resolves this to a
# full certificate-chain verification automatically, with no code-level
# ssl option needed at all; omitting it leaves the connection
# unencrypted, and Supabase's real pooler is expected to require TLS.
TRAFFIC_STRATEGY_MAP_DB_URL=postgresql://traffic_strategy_map_app.eukogyljakqafnuvrfiv:CHANGE_ME@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# AUTH-003B - this app's own OAuth 2.1 client registration in Supabase's
# OAuth Server (see docs/AUTH_003A_OAUTH_CLIENT_SETUP.md). Until ALL
# THREE of these plus TRAFFIC_STRATEGY_MAP_SESSION_SECRET below are set,
# /api/openai is DISABLED entirely (503 for every request, OpenAI never
# called) - see server.js and docs/AUTH_003A_SHARED_SECRET_REVIEW.md
# for why a temporary shared-secret alternative was considered and
# rejected for this app specifically.
#
# AUTH-003B same-origin proxy: the redirect URI is the PUBLIC domain's
# callback path (traffic-map.adveser.com), proxied to this backend's
# own route by vercel.json - NOT the raw Render URL directly. This
# must exactly match what's registered as this OAuth client's Redirect
# URI in Supabase (the token exchange re-sends this same value, and a
# compliant OAuth server rejects a mismatch) - the client secret still
# never reaches the browser either way, since the token exchange
# itself happens here, server-side, regardless of which URL the
# browser was redirected through to get here.
TRAFFIC_STRATEGY_MAP_OAUTH_CLIENT_ID=
TRAFFIC_STRATEGY_MAP_OAUTH_CLIENT_SECRET=
TRAFFIC_STRATEGY_MAP_OAUTH_REDIRECT_URI=https://traffic-map.adveser.com/auth/sso/callback

# AUTH-003B - signs/verifies this app's own first-party SSO session
# cookie (backend/auth/ssoSession.js) - a long, random value, generated
# once, never committed, never shared with the Supabase project's own
# JWT secret or any other app's session secret.
TRAFFIC_STRATEGY_MAP_SESSION_SECRET=

# AUTH-003B same-origin proxy (Option B, approved) - optional, defaults
# to Lax, correct now that frontend and backend are same-site via the
# Vercel reverse proxy (vercel.json). Set to None ONLY as an explicit,
# temporary rollback to the old split-origin shape (e.g. the proxy is
# briefly unavailable) - see docs/AUTH_003B_PRE_PRODUCTION_AUDIT.md.
# TRAFFIC_STRATEGY_MAP_COOKIE_SAMESITE=None
