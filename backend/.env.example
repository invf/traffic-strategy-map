OPENAI_API_KEY=sk-proj-your-key-here
FRONTEND_URL=https://your-app.vercel.app
PORT=3001

# AUTH-003A - required for the hardened /api/openai endpoint's auth check.
# The shared ADVESER Supabase project's own URL (eukogyljakqafnuvrfiv) -
# used only to verify tokens against its JWKS, never to query data directly.
SUPABASE_URL=https://eukogyljakqafnuvrfiv.supabase.co

# AUTH-003A - a direct Postgres connection as the dedicated
# traffic_strategy_map_app role (see supabase/migrations/
# 20261118120200_provision_app_role.sql) - SELECT-only on
# adveser_core.user_product_entitlements, INSERT-only on this app's own
# openai_usage table. Never the anon, service_role, or any admin credential.
TRAFFIC_STRATEGY_MAP_DB_URL=postgresql://traffic_strategy_map_app:CHANGE_ME@YOUR_PROJECT.pooler.supabase.com:6543/postgres?pgbouncer=true

# AUTH-003A - the client_id of THIS app's own OAuth client registration
# in Supabase's OAuth Server (see docs/AUTH_003A_OAUTH_CLIENT_SETUP.md).
# Without this set, requireAuth accepts a valid token from ANY OAuth
# client of the shared project, including a different product's - set
# this as soon as the client is registered, never leave it unset in
# Production once it exists.
TRAFFIC_STRATEGY_MAP_OAUTH_CLIENT_ID=
