# AUTH-003B - the browser never talks to Supabase directly anymore
# (public.strategies is RLS-protected; this app's backend relays
# requests on the signed-in user's behalf - see backend/routes/
# strategiesProxy.js). This is the only URL the frontend needs: the
# backend's own origin, used for /auth/sso/*, /api/openai, and
# /api/strategies.
VITE_API_URL=https://your-render-backend.onrender.com
